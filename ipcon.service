[Unit]
Description=IPCon v.1 - Professional IP Rotation System
Documentation=https://github.com/ipcon/v1
After=network-online.target tor.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ipconv
ExecStart=/usr/bin/python3 /opt/ipconv/ipcon.py start
ExecStop=/usr/bin/python3 /opt/ipconv/ipcon.py stop
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
Alias=ipcon.service
